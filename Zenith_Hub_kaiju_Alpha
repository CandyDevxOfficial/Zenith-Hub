local player = game.Players.LocalPlayer
local camera = game.Workspace.CurrentCamera
local currentForce = 0
local isMoving = false

-- ระบบขับเคลื่อนฟิสิกส์แบบ "ความเร็ว" สำหรับบินและว่ายน้ำ
game:GetService("RunService").Heartbeat:Connect(function()
    if isMoving then
        local char = player.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChild("Humanoid")
        
        if hrp and hum then
            if hum.MoveDirection.Magnitude > 0 then
                local isSwimming = hum:GetState() == Enum.HumanoidStateType.Swimming
                local isFlying = (hum:GetState() == Enum.HumanoidStateType.Freefall or hum:GetState() == Enum.HumanoidStateType.Climbing)
                
                if isSwimming or isFlying then
                    local lookDirection = camera.CFrame.LookVector
                    local rawMove = hum.MoveDirection
                    local combinedDirection = Vector3.new(rawMove.X, lookDirection.Y * rawMove.Magnitude, rawMove.Z).Unit
                    
                    hrp.AssemblyLinearVelocity = combinedDirection * (currentForce * 1.5)
                else
                    local targetVelocity = hum.MoveDirection * currentForce
                    if hrp.AssemblyLinearVelocity.Y > 50 or hrp.AssemblyLinearVelocity.Y < -50 then
                        hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                    else
                        hrp.AssemblyLinearVelocity = Vector3.new(targetVelocity.X, hrp.AssemblyLinearVelocity.Y, targetVelocity.Z)
                    end
                end
            else
                if hum:GetState() ~= Enum.HumanoidStateType.Swimming then
                    hrp.AssemblyLinearVelocity = Vector3.new(0, hrp.AssemblyLinearVelocity.Y, 0)
                end
            end
        end
    end
end)

-- ระบบกดเปิด/ปิดการทำงานความเร็ว
StartBtn.MouseButton1Click:Connect(function()
    isMoving = not isMoving
    
    if isMoving then
        val = tonumber(SpeedInput.Text)
        if val then 
            currentForce = val 
            StartBtn.Text = "ปิดความเร็ว (" .. val .. ")" 
            StartBtn.BackgroundColor3 = Color3.fromRGB(0, 255, 100)
            StartBtn.BackgroundTransparency = 0.35
        else
            isMoving = false
            StartBtn.Text = "กรุณาใส่ตัวเลข!"
            task.wait(1)
            StartBtn.Text = "เปิดใช้งานความเร็ว"
        end
    else
        currentForce = 0
        StartBtn.Text = "เปิดใช้งานความเร็ว"
        StartBtn.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
        StartBtn.BackgroundTransparency = 0.5
    end
end)

-- ฟังก์ชันกดลดกราฟิกแบบเรียลไทม์ (Boost FPS / Low GFX)
LowGFXBtn.MouseButton1Click:Connect(function()
    local Lighting = game:GetService("Lighting")
    
    -- ปิดเอฟเฟกต์แสงและเงาหนัก ๆ
    Lighting.GlobalShadows = false
    Lighting.FogEnd = 9e9
    Lighting.Brightness = 2
    for _, v in pairs(Lighting:GetChildren()) do
        if v:IsA("PostEffect") or v:IsA("Sky") or v:IsA("Atmosphere") or v:IsA("BloomEffect") or v:IsA("BlurEffect") or v:IsA("ColorCorrectionEffect") then
        v.Enabled = false
        end
    end

    -- ลดคุณภาพเรนเดอร์กราฟิกของตัวเกม
    pcall(function()
        settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
    end)

    -- ลบ/ซ่อนเอฟเฟกต์และรายละเอียดที่ไม่จำเป็นในแมพ
    for _, v in pairs(workspace:GetDescendants()) do
        if v:IsA("BasePart") then
            v.Material = Enum.Material.SmoothPlastic
            v.Reflectance = 0
        elseif v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Fire") or v:IsA("Smoke") or v:IsA("Sparkles") then
            v.Enabled = false
        elseif v:IsA("Decal") or v:IsA("Texture") then
            v.Transparency = 1
        end
    end
    
    LowGFXBtn.Text = "⚡ เร่งเครื่อง FPS สำเร็จ!"
    task.wait(1.5)
    LowGFXBtn.Text = "🖼️ ลดกราฟิกแบบจริงจัง"
end)
